# Regenerates the README's IDL appendix and table of contents when README.md
# or index.bs is part of the commit. Enable once per clone with
# `git config core.hooksPath .githooks`.

git diff --cached --quiet -- README.md index.bs && exit 0

if ! git diff --quiet -- README.md; then
  # Staging the regenerated file would also stage these unrelated edits.
  echo "pre-commit: README.md has unstaged changes; stage or stash them first." >&2
  exit 1
fi

# Read the staged spec, so unstaged IDL edits don't leak into the commit.
git show :index.bs | node scripts/idl.mjs README.md - || exit 1
node scripts/toc.mjs README.md || exit 1
git add README.md
