# Regenerates the README table of contents when README.md is part of the
# commit. Enable once per clone with `git config core.hooksPath .githooks`.

git diff --cached --quiet -- README.md && exit 0

if ! git diff --quiet -- README.md; then
  # Staging the regenerated file would also stage these unrelated edits.
  echo "pre-commit: README.md has unstaged changes; stage or stash them first." >&2
  exit 1
fi

node scripts/toc.mjs README.md || exit 1
git add README.md
